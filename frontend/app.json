{
  "expo": {
    "name": "TaskAware",
    "slug": "MyHelloWorldApp",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./icon.png",
    "scheme": "taskawareapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "location",
          "fetch"
        ],
        "NSLocationWhenInUseUsageDescription": "האפליקציה צריכה מיקום כדי למצוא עסקים רלוונטיים למשימות שלך.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "האפליקציה צריכה גישה למיקום ברקע כדי להתריע לך כשאתה עובר ליד מקום שקשור למשימה שלך."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.shlomo1155.MyMyHelloWorldAppApp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "תנו גישה למיקום תמיד כדי לקבל התראות כשאתם קרובים למשימה."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24e2be65-d267-48fc-a4a1-0b4fbbe694d6"
      }
    },
    "owner": "shlomo1155",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/24e2be65-d267-48fc-a4a1-0b4fbbe694d6",
      "requestHeaders": {
        "accept": "application/json"
      }
    }
  }
}
